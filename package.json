{
  "name": "statoo-5v5",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "icons": "node scripts/generate-icons.cjs",
    "postinstall": "nuxt prepare && node -e \"const fs=require('fs'); fs.mkdirSync('public/assets',{recursive:true}); fs.copyFileSync('node_modules/sql.js/dist/sql-wasm.wasm','public/assets/sql-wasm.wasm'); fs.copyFileSync('node_modules/sql.js/dist/sql-wasm.wasm','public/sql-wasm.wasm');\"",
    "cap:init": "npx cap init \"Statoo 5v5\" com.elnor.statoo5v5",
    "cap:add-android": "npx cap add android",
    "cap:copy": "npm run generate && npx cap copy",
    "cap:open-android": "npx cap open android",
    "cap:build-android": "cd android && gradlew.bat assembleRelease"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^6.0.0",
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@nuxt/fonts": "^0.10.0",
    "@nuxt/ui": "^3.0.0-alpha.15",
    "@tailwindcss/vite": "^4.0.0",
    "jeep-sqlite": "^2.6.0",
    "nuxt": "^3.15.4",
    "tailwindcss": "^4.0.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/node": "^22.0.0",
    "@vite-pwa/nuxt": "^1.1.1",
    "typescript": "^5.7.3"
  }
}
